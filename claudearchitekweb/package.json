{
  "name": "architeksoft-web-system",
  "version": "0.1.0",
  "private": true,
  "description": "ArchiTek Soft web ecosystem: client website (KitchenPro), client pages, admin dashboard (CRM, media, analytics), SMM automation with Telegram approval.",
  "scripts": {
    "dev": "next dev -p 3100 --turbopack",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "tsx scripts/worker.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:generate": "drizzle-kit generate",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "dev:webpack": "next dev -p 3100",
    "build:standalone": "cross-env-shell \"NEXT_STANDALONE=1 next build\" 2>/dev/null || set NEXT_STANDALONE=1&& next build",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^0.560.0",
    "next": "15.5.25",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.4.0",
    "sharp": "^0.34.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
