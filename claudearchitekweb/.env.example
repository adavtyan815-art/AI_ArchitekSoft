# ============================================================
# ArchiTek Soft Web System — environment configuration
# Copy to .env and fill what you have. Everything is optional
# for local testing: missing integrations run in "dry-run" mode.
# For a server, start from deploy/.env.production.example instead.
# Every active variable below is read by the code: src/lib/env.ts, plus
# LINKEDIN_API_VERSION and YOUTUBE_PRIVACY in src/lib/social/index.ts. The
# commented "Server only" block at the end is read by next.config.ts and by
# the files in deploy/, not by the app. Nothing here is decorative.
# ============================================================

# --- App -----------------------------------------------------
# Public base URL. Used in links, QR codes and the media URLs Instagram fetches. Trailing slash stripped.
APP_URL=http://localhost:3100
# development | production. Production turns on the first-boot password and secret checks below.
NODE_ENV=development
# 32+ random characters (`openssl rand -base64 48`). Salts the visitor and IP hashes stored with
# analytics and client-page events, keys the client-page passcode cookie and derives the Telegram
# /setadmin code. Admin sessions do not depend on it; changing it re-asks visitors for passcodes,
# invalidates the /setadmin code and makes old analytics hashes stop matching the new ones.
APP_SECRET=change-me-to-a-long-random-string
# SQLite file. Created (with its folder) and migrated on first access.
DATABASE_PATH=./data/architeksoft.db
# Where uploaded originals, derived social images and the resize cache live.
UPLOAD_DIR=./data/uploads
# Drop folder: copy renders (and an optional post.txt brief) into a sub-folder here and the system
# prepares a post draft and suggests it. Created with a README, _processing/, _imported/ and _failed/
# on first boot; see docs/15_INBOX_WORKFLOW.md. May point at a synced folder (OneDrive, a share).
INBOX_DIR=./data/inbox
# Royalty-free ambient tracks for the SMM editor's "Auto Ambient" background-audio choice. Created
# with a README on first boot; drop .mp3 files in and they appear in the picker with no other setup.
AUDIO_DIR=./data/audio
# true: the 60-second scheduler, the inbox scan and Telegram long polling run inside the web process
# (simplest local setup). false: run them separately with `npm run worker` (or the split-worker container).
RUN_WORKER_IN_APP=true

# --- First admin ---------------------------------------------
# Used ONCE, to create the owner account on a database that has no users yet. Changing these values
# later has no effect: change the password in Admin → Settings → Security.
# E-mail of the owner account created on the first boot.
ADMIN_EMAIL=admin@architeksoft.com
# With NODE_ENV=production the app refuses to create the account (and logs an error) when this is
# missing, this published testing default, a placeholder, or shorter than 12 characters.
ADMIN_PASSWORD=architek2026
# Display name of that first account.
ADMIN_NAME=Admin

# --- AI copywriting (Claude first, Gemini fallback, template fallback if none) ---
# Anthropic API key; empty means the template fallback writes the drafts.
ANTHROPIC_API_KEY=
# Model for post copy and rewrites. Default claude-opus-5; claude-sonnet-5 / claude-haiku-4-5 cost less.
ANTHROPIC_MODEL=claude-opus-5
# Google Gemini key, used only when the Anthropic call fails or has no key.
GEMINI_API_KEY=
# Gemini model for that fallback.
GEMINI_MODEL=gemini-2.5-flash

# --- Telegram (approval workflow + notifications) -------------
# 1) Create a bot with @BotFather and paste the token here, then restart.
# 2) Open Admin → Settings → Telegram, copy the `/setadmin <code>` line shown there and send it to
#    the bot from the chat that should receive approvals (or send /chatid and paste the id into the form).
TELEGRAM_BOT_TOKEN=
# Optional starting value for the admin chat: it is only the default of the Settings → Telegram field,
# and a value saved there wins. Leave empty and bind the chat from Telegram.
TELEGRAM_ADMIN_CHAT_ID=
# Optional public channel to auto-post to (@username or -100… id). Same rule: default of the Settings field.
TELEGRAM_CHANNEL_ID=

# --- Facebook / Instagram (Meta Graph API) -------------------
# Facebook Page id.
META_PAGE_ID=
# Non-expiring Page access token (from a long-lived user token via /me/accounts).
META_PAGE_ACCESS_TOKEN=
# Instagram Business user id linked to that Page. Instagram fetches media by URL, so APP_URL must be public HTTPS.
META_IG_USER_ID=

# --- LinkedIn (Community Management API) ---------------------
# Both values are needed. Leave the URN empty until you have the real one: a placeholder would make
# the app believe LinkedIn is connected and every post would be rejected by LinkedIn.
# Member token authorised for the organisation (about 60 days; re-authorise before it lapses).
LINKEDIN_ACCESS_TOKEN=
# Format: urn:li:organization:<numeric id> — anything else keeps LinkedIn in dry-run.
LINKEDIN_ORG_URN=
# Versioned API header, YYYYMM. Optional: the code default is 202606. LinkedIn supports a version for
# about a year, so this must be bumped roughly once a year; a 426 answer names this variable.
LINKEDIN_API_VERSION=202606

# --- YouTube (Data API v3, OAuth refresh token) --------------
# OAuth client id (Desktop client in your Google Cloud project).
YOUTUBE_CLIENT_ID=
# OAuth client secret.
YOUTUBE_CLIENT_SECRET=
# Refresh token for the youtube.upload scope.
YOUTUBE_REFRESH_TOKEN=
# public | unlisted | private. The code default is "public"; keep it private until the Google API
# compliance audit passes, otherwise the upload is rejected.
YOUTUBE_PRIVACY=private

# --- Existing Pixel Streaming backend (live.architeksoft.com) --
# Base URL of that backend. Also the default of the Settings → Live 3D field, which wins when set.
LIVE_BACKEND_URL=https://live.architeksoft.com
# Admin user of that backend; empty means /admin/live shows "not configured" instead of instances.
LIVE_ADMIN_USERNAME=
# Password of that admin user.
LIVE_ADMIN_PASSWORD=

# --- Email notifications (optional, Resend) ------------------
# Resend API key; empty means e-mail notifications are skipped (Telegram still works).
RESEND_API_KEY=
# Sender of those notifications; the domain must be verified in Resend.
NOTIFY_EMAIL_FROM=ArchiTek Soft <no-reply@architeksoft.com>
# Recipient of internal notifications (new lead, approval reminders, daily brief by e-mail).
NOTIFY_EMAIL_TO=architeksoft@gmail.com

# --- Server only (see deploy/ and docs/08_DEPLOYMENT.md) ------
# SITE_HOST: the domain Caddy requests a certificate for. One host, or a space-separated list.
# SITE_HOST=new.architeksoft.com
# INBOX_HOST_DIR: the HOST folder compose bind-mounts at /app/inbox. On a server set this instead of
# INBOX_DIR — compose sets INBOX_DIR=/app/inbox inside the containers itself.
# INBOX_HOST_DIR=../data/inbox
# NEXT_STANDALONE=1 makes `next build` emit .next/standalone for the Docker image. The Dockerfile
# sets it itself; you only need it when you build outside Docker (`npm run build:standalone`).
# NEXT_STANDALONE=1

# --- `npm run perf` only (scripts/perf.mjs) -------------------
# Not app configuration: set these on the command line for one probe run, not in .env.
# PERF_SHARE_URL: a client-page address to include in the probe (`/p/<slug>?k=<token>`).
# PERF_SHARE_URL=
# PERF_COOKIE: an admin session cookie, so the probe also measures the dashboard routes.
# PERF_COOKIE=
