# Copy to ../.env on the server and fill in. Both containers read this file (env_file: ../.env), and
# compose itself reads it with `docker compose -f deploy/docker-compose.yml --env-file .env ...`.
APP_URL=https://new.architeksoft.com
# The domain Caddy requests a certificate for. One host, or a space-separated list at go-live, e.g.
#   SITE_HOST=www.architeksoft.com architeksoft.com
SITE_HOST=new.architeksoft.com
NODE_ENV=production
# 32+ random characters, e.g. `openssl rand -base64 48`. Salts analytics/client-page visitor hashes
# and keys the client-page passcode cookie. Settings → Security warns while this placeholder is here.
APP_SECRET=REPLACE_WITH_64_RANDOM_CHARACTERS
# true: scheduler + Telegram bot run inside the web container (recommended).
# false: run them in the `worker` service — `docker compose --profile split-worker up -d`.
RUN_WORKER_IN_APP=true

# Drop folder: copy renders (and an optional post.txt brief) into a sub-folder here and the system
# prepares a post draft and suggests it; see docs/15_INBOX_WORKFLOW.md. This is the path ON THE
# HOST — compose bind-mounts it into the containers and sets INBOX_DIR=/app/inbox itself, so do not
# set INBOX_DIR here. Relative paths are resolved from deploy/, so the default lands in
# claudearchitekweb/data/inbox. Point it at an SFTP/Syncthing/rclone folder if you would rather
# drop the renders from your desktop. Create it before the first `up`:
#   mkdir -p data/inbox
INBOX_HOST_DIR=../data/inbox

# Creates the owner account on the FIRST start of an empty database and is never read again;
# change the password afterwards in Admin → Settings → Security.
# In production the app refuses to create the account (and logs an error) while ADMIN_PASSWORD is a
# placeholder or shorter than 12 characters — set a real one before the first start.
ADMIN_EMAIL=admin@architeksoft.com
ADMIN_PASSWORD=REPLACE_ME
ADMIN_NAME=Admin

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
GEMINI_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CHANNEL_ID=

META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
LINKEDIN_ACCESS_TOKEN=
# Format: urn:li:organization:<numeric id> — leave empty until you have the real one, a placeholder
# would look "connected" in Settings and every post would be rejected by LinkedIn.
LINKEDIN_ORG_URN=
LINKEDIN_API_VERSION=202506
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=private

LIVE_BACKEND_URL=https://live.architeksoft.com
LIVE_ADMIN_USERNAME=
LIVE_ADMIN_PASSWORD=

RESEND_API_KEY=
NOTIFY_EMAIL_FROM=ArchiTek Soft <no-reply@architeksoft.com>
NOTIFY_EMAIL_TO=architeksoft@gmail.com

# Litestream (optional): Cloudflare R2 S3-compatible credentials
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
