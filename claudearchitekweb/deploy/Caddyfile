# SITE_HOST comes from claudearchitekweb/.env (the caddy service loads it with env_file).
# One host, or a space-separated list when the site goes live on the main domain, e.g.
#   SITE_HOST=www.architeksoft.com architeksoft.com
{
	servers {
		# The site sits behind the Cloudflare proxy (orange cloud): only Cloudflare's edge may tell us
		# who the visitor is. Anything that reaches the server directly is identified by its own address.
		# Ranges: https://www.cloudflare.com/ips/ — re-check them once or twice a year.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$SITE_HOST:new.architeksoft.com} {
	encode zstd gzip
	# Cloudflare's proxy rejects request bodies above 100 MB, so that is the effective upload limit.
	# Keep this equal to MAX_UPLOAD_BYTES in src/lib/media.ts, so the admin shows a clear message
	# instead of a proxy error (see docs/08_DEPLOYMENT.md, "Upload size").
	request_body {
		max_size 100MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy web:3100 {
		flush_interval -1
		# {client_ip} is the visitor's address as verified above (CF-Connecting-IP only when the request
		# really came from Cloudflare, otherwise the socket address). The app keys its rate limits and
		# visitor hashes on it, so client-supplied forwarding headers never reach the app.
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
		header_up -CF-Connecting-IP
	}
}

# Go-live on the main domain — pick one:
#  a) serve both names: set SITE_HOST=www.architeksoft.com architeksoft.com in .env (nothing to change here), or
#  b) serve www only and redirect the bare domain to it: set SITE_HOST=www.architeksoft.com and uncomment:
# architeksoft.com {
# 	redir https://www.architeksoft.com{uri} permanent
# }
